# Puerto del agente (http://localhost:4000)
PORT=4000
# Navegador del analizador: deja vacío para Chromium de Playwright, o "chrome"/"msedge" para usar el instalado
AGENT_BROWSER_CHANNEL=
AGENT_HEADLESS=true
# Opcional: enriquecer casos de prueba con Claude a partir de historias de usuario
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
