# Puerto del agente (http://localhost:4000)
PORT=4000
# Navegador del analizador: "chrome" (Google Chrome instalado, por defecto), "msedge", o vacío para Chromium de Playwright
AGENT_BROWSER_CHANNEL=chrome
AGENT_HEADLESS=true
# Opcional: enriquecer casos de prueba con Claude a partir de historias de usuario
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
